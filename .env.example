# Payload CMS Secret
PAYLOAD_SECRET=your-payload-secret-here

# Database URI
# Local development (default):
DATABASE_URI=file:./data/payload.db
# Production (Neon PostgreSQL):
# DATABASE_URI=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Media Storage (Neon Object Storage - Tigris / S3 Compatible)
# Obtain these from your Neon Console under "Object Storage"
S3_BUCKET=your-neon-bucket-name
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: If you have a custom CDN or public domain
# S3_PUBLIC_URL=https://...

# Alternative: Cloudflare R2
# R2_BUCKET=your-r2-bucket-name
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev

# Email Notifications (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAILJS_VOLUNTEER_TEMPLATE_ID=your-volunteer-template-id
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your-contact-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
NEXT_PUBLIC_STAFF_EMAIL=ashramgandhipuriorg@gmail.com

