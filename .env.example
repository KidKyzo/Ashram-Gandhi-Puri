# Payload CMS Secret
# Required in production: use a private, randomly generated value (at least 32 characters).
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=your-payload-secret-here

# Database URI
# Local development (default):
DATABASE_URI=file:./data/payload.db
# Schema changes are applied with npm run cms:migrate; automatic schema push is disabled.
# Production (Neon PostgreSQL):
# DATABASE_URI=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Media Storage (Neon Object Storage - Tigris / S3 Compatible)
# Obtain these from your Neon Console under "Object Storage"
S3_BUCKET=your-neon-bucket-name
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: If you have a custom CDN or public domain
# S3_PUBLIC_URL=https://...

# Alternative: Cloudflare R2
# R2_BUCKET=your-r2-bucket-name
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev

# Email via EmailJS templates (server-side calls to the EmailJS REST API)
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# One dynamic template shared by contact and volunteer forms
EMAILJS_INQUIRY_TEMPLATE_ID=your-shared-inquiry-template-id
# Donation template; configure proof_attachment as a variable attachment in EmailJS
EMAILJS_DONATION_TEMPLATE_ID=your-donation-template-id
STAFF_EMAIL=ashramgandhipuriorg@gmail.com


